{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["vite/client", "node", "bun"],
		"paths": { "@/*": ["./src/*"] },
		"ignoreDeprecations": "6.0"
	},
	"include": ["src", "server", "vite.config.ts", "e2e", "playwright.config.ts"]
}
